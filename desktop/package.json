{
  "name": "dalnight-launcher",
  "productName": "DalNight",
  "version": "1.0.0",
  "description": "달 없는 밤: 등불을 든 자 — PC 실행기",
  "author": "gh920327",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gh920327.dalnight",
    "productName": "DalNight",
    "copyright": "달 없는 밤: 등불을 든 자",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "splash.html",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "DalNight",
      "artifactName": "DalNight-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "달 없는 밤",
      "uninstallDisplayName": "달 없는 밤: 등불을 든 자",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gh920327-cmyk",
        "repo": "blood-catacomb",
        "releaseType": "release"
      }
    ]
  }
}
